# ===============================
# API Keys Configuration
# ===============================

OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ===============================
# LLM Provider Routing
# ===============================

# Use one provider directly: openrouter | openai | groq | gemini
# Or use auto to try providers in order until one succeeds.
LLM_PROVIDER="auto"
LLM_PROVIDER_ORDER="openrouter,groq,gemini,openai"

# Default model to use for each provider.
LLM_OPENROUTER_MODEL="openai/gpt-4o-mini"
LLM_OPENAI_MODEL="gpt-4o"
LLM_GROQ_MODEL="llama-3.3-70b-versatile"
LLM_GEMINI_MODEL="gemini-2.5-flash"

# ===============================
# Jarvis Sleep Timing
# ===============================

# Time in seconds before Jarvis enters full sleep after inactivity.
IDLE_SLEEP_TIMEOUT_SECONDS="300"

# Time in seconds Jarvis stays responsive for follow-up commands
# after wake word detection or a recent interaction.
FOLLOW_UP_WINDOW_SECONDS="120"

# ===============================
# Optional computer-unlock settings
# ===============================

# AUTH_USER:
# The username associated with the authorized voice profile.
# This must match the name of the user whose voice is recognized by the system.
# Example: if your voice model is trained for "alex", then set AUTH_USER="alex".
AUTH_USER=""

# AUTH_PASSWORD:
# The local system password used to unlock the computer
# (e.g., Windows login PIN or macOS/Linux account password).
# Keep this secret. The feature remains disabled unless explicitly enabled below.
ENABLE_PC_UNLOCK="false"
AUTH_PASSWORD=""

# ===============================
# External Service Integrations
# ===============================

# Blynk (IoT)
BLYNK_TEMPLATE_ID=""
BLYNK_TEMPLATE_NAME=""
BLYNK_AUTH_TOKEN=""

# Hugging Face
HF_AUTH_TOKEN=""

# OpenWeather
OPENWEATHER_API_KEY=""

# Optional comma-separated search roots for desktop/media discovery.
# DESKTOP_INDEX_ROOTS="/home/you/Projects,/home/you/Documents"
# MEDIA_SEARCH_ROOTS="/home/you/Music,/home/you/Videos"

# auto: resolve files by name; picker: always display a file chooser.
TRANSCRIBE_FILE_SELECTION="auto"
